# ==============================================================================
# INFOSOF TECHNOLOGIES - Pharmacy Management Software Environment Configuration
# ==============================================================================

APP_NAME="INFOSOF Pharmacy Management"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# Database Driver ('mysql' for TiDB Cloud / MySQL; 'sqlite' for zero-config dev)
# ------------------------------------------------------------------------------
DB_DRIVER=mysql

# ------------------------------------------------------------------------------
# Option 1: TiDB Cloud Single URL (Recommended for Render)
# Copy "Connection String" directly from TiDB Cloud Console -> Connect -> General
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://<user>:<password>@<host>:4000/<database>?sslmode=verify-full
# Or TIDB_DATABASE_URL=...

# ------------------------------------------------------------------------------
# Option 2: TiDB Cloud Dedicated Variables
# ------------------------------------------------------------------------------
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=2xXXXXXXXX.root
# TIDB_PASSWORD=your_tidb_password
# TIDB_DATABASE=pharmacy_db
# TIDB_ENABLE_SSL=true

# ------------------------------------------------------------------------------
# Option 3: Standard MySQL / Localhost XAMPP
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmacy_db
DB_USER=root
DB_PASS=

SESSION_LIFETIME=7200
