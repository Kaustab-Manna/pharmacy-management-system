# ==============================================================================
# INFOSOF TECHNOLOGIES - Pharmacy Management Software Environment Configuration
# ==============================================================================

APP_NAME="INFOSOF Pharmacy Management"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database Driver: 'sqlite' or 'mysql'
DB_DRIVER=sqlite

# MySQL / Cloud DB (Render / Cleardb / PlanetScale)
# Can also provide single DATABASE_URL=mysql://user:pass@host:port/dbname
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharmacy_db
DB_USER=root
DB_PASS=

SESSION_LIFETIME=7200
